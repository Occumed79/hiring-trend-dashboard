{
  "name": "hiring-trend-dashboard",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build.js",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:source": "node --test tests/*.test.js",
    "ci": "npm run test:source && npm run typecheck && npm run build",
    "db:migrate": "node scripts/migrate.js",
    "ingest": "node scripts/ingest.js",
    "probe:theirstack-exports": "node scripts/probe-theirstack-exports.js",
    "benchmark": "node scripts/run-benchmarks.js",
    "benchmark:scheduled": "node scripts/run-benchmarks.js --scheduled",
    "benchmark:source-pairs": "node scripts/rebuild-source-pair-baselines.js",
    "benchmark:capture-truth": "node scripts/capture-benchmark-truth.js",
    "sync:government-registry": "node scripts/sync-government-registry.js",
    "sync:source-directories": "node scripts/sync-source-directories.js",
    "enrich:association-sources": "node scripts/enrich-association-job-urls.js",
    "import:crawler": "node scripts/import-crawler-jsonl.js",
    "crawler:batch": "python3 scrapers/run_batch.py"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.9.3",
    "@types/leaflet": "^1.9.12",
    "@types/node": "^20",
    "@types/pg": "^8.11.6",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.19",
    "axios": "^1.7.2",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "drizzle-kit": "^0.21.4",
    "drizzle-orm": "^0.30.10",
    "eslint": "^8",
    "eslint-config-next": "14.2.3",
    "framer-motion": "^11.2.6",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^0.379.0",
    "next": "14.2.3",
    "node-cron": "^3.0.3",
    "pg": "^8.11.5",
    "postcss": "^8.4.38",
    "react": "^18",
    "react-dom": "^18",
    "react-leaflet": "^4.2.1",
    "recharts": "^2.12.4",
    "tailwindcss": "^3.4.1",
    "ts-jobspy": "2.0.3",
    "typescript": "^5"
  },
  "devDependencies": {
    "dotenv": "^16.4.5"
  }
