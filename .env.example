# ─────────────────────────────────────────────────────────────────
# Neon Postgres (required)
# ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/hiring_dashboard?sslmode=require

# ─────────────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=replace_with_a_long_random_string

# ─────────────────────────────────────────────────────────────────
# Census Government Units Registry
# The sync command downloads the official Census annual government-unit ZIP.
# Run: npm run sync:government-registry
# Daily cron uses --if-stale so it normally refreshes only every 30 days.
# ─────────────────────────────────────────────────────────────────
CENSUS_GOVERNMENT_REGISTRY_YEAR=2025
CENSUS_GOVERNMENT_REGISTRY_URL=https://www2.census.gov/programs-surveys/gus/datasets/2025/gov_units_2025.zip
CENSUS_GOVERNMENT_REGISTRY_STALE_DAYS=30
CENSUS_GOVERNMENT_REGISTRY_BATCH_SIZE=250

# ─────────────────────────────────────────────────────────────────
# NEOGOV / GovernmentJobs
# GovernmentJobs agencies resolved to /careers/<agency> are read through the
# authorized agency RSS feed and reconciled as an authoritative inventory.
# No credential is required by this connector.
# ─────────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────────
# National Labor Exchange (NLx) API 2.0
# Configure after NLx Research Hub access is issued. The connector is already
# wired for Current Clients, Prospects, Private Companies and government portals.
# Use NLX_API_URL_TEMPLATE if your approved profile uses parameter/header names
# different from the defaults below. {page}, {start}, {end}, {state}/{states},
# and {employer} are supported template placeholders.
# ─────────────────────────────────────────────────────────────────
NLX_API_KEY=
NLX_API_KEY_HEADER=X-API-Key
NLX_API_BASE_URL=https://api.nlxresearchhub.com/v2/jobs
NLX_LOOKBACK_DAYS=30
NLX_DEFAULT_STATE=
NLX_STATES=
NLX_STATE_PARAM=state
NLX_EMPLOYER_PARAM=employer
NLX_EXPIRED_PARAM=expired
NLX_PAGE_PARAM=page
NLX_CURSOR_PARAM=cursor
NLX_PAGE_SIZE=50
NLX_MAX_PAGES=40
NLX_API_URL_TEMPLATE=
NLX_EXTRA_QUERY_JSON=

# ─────────────────────────────────────────────────────────────────
# Adzuna API
# Used only by: Current Clients, Prospects, Private Companies.
# Government portals intentionally do NOT use Adzuna as a baseline source.
# ─────────────────────────────────────────────────────────────────
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key

# ─────────────────────────────────────────────────────────────────
# USAJOBS API — Federal Agencies only
# USAJOBS_USER_AGENT should be the email you registered with.
# Federal ingest resolves Agency Subelement organization codes and paginates.
# ─────────────────────────────────────────────────────────────────
USAJOBS_API_KEY=your_usajobs_api_key
USAJOBS_USER_AGENT=your_email@example.com
USAJOBS_RESULTS_PER_PAGE=500
USAJOBS_MAX_PAGES=20

# ─────────────────────────────────────────────────────────────────
# LangSearch
# Used for employer-verified job discovery, official government career-source
# discovery, and supplemental NACo / ICMA / Careers in Government verification.
# ─────────────────────────────────────────────────────────────────
LANGSEARCH_API_KEY=
LANGSEARCH_API_KEY_2=
LANGSEARCH_MODE=always
LANGSEARCH_FRESHNESS=oneMonth
LANGSEARCH_TIMEOUT_MS=12000

# ─────────────────────────────────────────────────────────────────
# Private Companies Portal — optional authoritative custom feed
# If missing, the portal falls back to ATS + career page + NLx (when configured)
# + verified discovery.
# ─────────────────────────────────────────────────────────────────
PRIVATE_SECTOR_HIRING_API_KEY=
PRIVATE_SECTOR_HIRING_API_BASE_URL=

# ─────────────────────────────────────────────────────────────────
# Federal Agencies Portal — optional custom authoritative feed
# If missing, the portal uses USAJOBS + authoritative agency career surfaces.
# ─────────────────────────────────────────────────────────────────
FEDERAL_HIRING_API_KEY=
FEDERAL_HIRING_API_BASE_URL=

# ─────────────────────────────────────────────────────────────────
# State Agencies Portal — optional custom authoritative feed
# If missing, the portal uses official .gov / GovernmentJobs / NEOGOV / ATS
# career surfaces, Census identity where applicable, NLx when configured, and
# employer-verified public-sector boards. Never USAJOBS.
# ─────────────────────────────────────────────────────────────────
STATE_HIRING_API_KEY=
STATE_HIRING_API_BASE_URL=

# ─────────────────────────────────────────────────────────────────
# Counties & Cities Portal — optional authoritative custom feeds
# Uses Census government identity + official local-government career systems +
# authorized NEOGOV/GovernmentJobs + NLx + NACo/ICMA/Careers in Government.
# Never substitutes USAJOBS or unverified Adzuna results.
# ─────────────────────────────────────────────────────────────────
COUNTY_HIRING_API_KEY=
COUNTY_HIRING_API_BASE_URL=
CITY_HIRING_API_KEY=
CITY_HIRING_API_BASE_URL=
MUNICIPAL_HIRING_API_KEY=
MUNICIPAL_HIRING_API_BASE_URL=

# ─────────────────────────────────────────────────────────────────
# Jobs API adapters
# Put the real credential only in .env.local or Render environment variables.
# Never commit the real value here.
# ─────────────────────────────────────────────────────────────────
JOB_API_TOKEN=replace_with_provider_credential

# JSearch default adapter
JOB_API_JSEARCH_HOST=jsearch.p.rapidapi.com
JOB_API_JSEARCH_PATH=/search

# Optional adapters. Enable the ones you actually want in JOB_API_ADAPTERS.
JOB_API_INDEED_HOST=indeed-realtime-job-search-api.p.rapidapi.com
JOB_API_INDEED_PATH=/search
JOB_API_LINKEDIN_HOST=linkedin-jobs-search.p.rapidapi.com
JOB_API_LINKEDIN_PATH=/search
JOB_API_GOOGLE_JOBS_HOST=google-jobs-search.p.rapidapi.com
JOB_API_GOOGLE_JOBS_PATH=/search
JOB_API_ZIPRECRUITER_HOST=ziprecruiter-api.p.rapidapi.com
JOB_API_ZIPRECRUITER_PATH=/search
JOB_API_GLASSDOOR_HOST=glassdoor-real-time-job-search.p.rapidapi.com
JOB_API_GLASSDOOR_PATH=/search
JOB_API_JOBBANK_HOST=jobbank-real-time-linkedin-indeed-glassdoor.p.rapidapi.com
JOB_API_JOBBANK_PATH=/search
JOB_API_JOBFINDER_HOST=jobfinder.p.rapidapi.com
JOB_API_JOBFINDER_PATH=/search
JOB_API_LATEST_JOBS_HOST=latest-jobs-api.p.rapidapi.com
JOB_API_LATEST_JOBS_PATH=/search
JOB_API_JOB_SEARCH_AI_HOST=job-search-ai.p.rapidapi.com
JOB_API_JOB_SEARCH_AI_PATH=/search
JOB_API_REALTIME_LINKEDIN_HOST=real-time-linkedin-job-search-api.p.rapidapi.com
JOB_API_REALTIME_LINKEDIN_PATH=/search
JOB_API_JOB_LISTINGS_HOST=job-listings-aggregator.p.rapidapi.com
JOB_API_JOB_LISTINGS_PATH=/search
JOB_API_JOB_SEARCH_REALTIME_HOST=job-search-real-time-data.p.rapidapi.com
JOB_API_JOB_SEARCH_REALTIME_PATH=/search
JOB_API_JOBS_HOST=jobs-api.p.rapidapi.com
JOB_API_JOBS_PATH=/search
JOB_API_JOB_PARSER_HOST=job-parser.p.rapidapi.com
JOB_API_JOB_PARSER_PATH=/parse
JOB_API_LEAD_SCRAPER_HOST=lead-scraper.p.rapidapi.com
JOB_API_LEAD_SCRAPER_PATH=/search
JOB_API_HIREBASE_HOST=hirebase-jobs-data.p.rapidapi.com
JOB_API_HIREBASE_PATH=/search
JOB_API_INTERNSIGNAL_HOST=internsignal-jobs-api.p.rapidapi.com
JOB_API_INTERNSIGNAL_PATH=/search
JOB_API_YC_JOBS_HOST=free-y-combinator-jobs-api.p.rapidapi.com
JOB_API_YC_JOBS_PATH=/search
JOB_API_JOB_POSTING_FEED_HOST=job-posting-feed-api.p.rapidapi.com
JOB_API_JOB_POSTING_FEED_PATH=/feed
JOB_API_ACTIVE_JOBS_HOST=active-jobs-db.p.rapidapi.com
JOB_API_ACTIVE_JOBS_PATH=/search

# Adapter configuration
# JOB_API_MODE=fallback only calls paid/rate-limited job APIs when earlier sources return too little.
# JOB_API_MODE=always forces job API use. JOB_API_MODE=off disables job API use.
JOB_API_MODE=fallback
JOB_API_FALLBACK_MIN_EXISTING=1
JOB_API_ADAPTERS=jsearch
JOB_API_COUNTRY=us
JOB_API_LIMIT=25
JOB_API_DATE_POSTED=month
JOB_API_TIMEOUT_MS=12000
